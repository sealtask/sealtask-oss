{
  "name": "@sealtask/crypto-web",
  "version": "0.2.0",
  "private": true,
  "description": "SealTask browser cryptography runtime, encrypted protocols, and trust verification engine",
  "type": "module",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/sealtask/sealtask-oss/tree/main/packages/crypto-web",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sealtask/sealtask-oss.git",
    "directory": "packages/crypto-web"
  },
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./runtime/*": "./src/runtime/*.ts",
    "./protocols": "./src/protocols/index.ts",
    "./protocols/*": "./src/protocols/*.ts",
    "./trust": "./src/trust/index.ts",
    "./trust/*": "./src/trust/*.ts"
  },
  "types": "./src/index.ts",
  "sideEffects": [
    "./src/runtime/argon2.ts",
    "./src/runtime/strong-box.worker.ts"
  ],
  "scripts": {
    "check": "bun run check:boundary && bun run typecheck && bun run test",
    "check:boundary": "node --test scripts/check-boundary.test.mjs && node scripts/check-boundary.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test -c playwright.config.ts --project=secure-chromium"
  },
  "dependencies": {
    "@noble/ed25519": "3.1.0",
    "@serenity-kit/opaque": "1.1.0",
    "argon2-browser": "1.18.0",
    "cbor-x": "1.6.0"
  }
}
